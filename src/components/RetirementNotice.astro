---
import SiteLayout from '../layouts/SiteLayout.astro';
import type { RetiredItem } from '../lib/retirements.mjs';
interface Props { item: RetiredItem; }
const { item } = Astro.props;
---
<SiteLayout title={`${item.name} · Unavailable`} description={item.reason} canonicalPath={item.path}>
  <article class="retirement">
    <p class="eyebrow">Content no longer available</p>
    <h1>{item.name}</h1>
    <p>{item.reason}</p>
    <div class="retirement-actions">
      {item.replacement && <a class="button button--primary" href={item.replacement}>View replacement</a>}
      <a class="button button--secondary" href={item.path.startsWith('/heroes/') ? '/heroes/' : '/preparations/'}>Browse available items</a>
    </div>
  </article>
</SiteLayout>
<style>.retirement{max-width:800px;margin:auto;padding:72px 24px}.retirement h1{font-size:clamp(2rem,6vw,3.5rem);margin:20px 0;overflow-wrap:anywhere}.retirement p{line-height:1.7}.retirement-actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:32px}</style>
