---
import { Image } from 'astro:assets';
interface Props { src: string; size?: number; eager?: boolean; }
const { src, size = 88, eager = false } = Astro.props;
---
<Image src={src} alt="" width={size} height={size} widths={[size, size * 2]} sizes={`${size}px`} format="webp" quality={75} loading={eager ? 'eager' : 'lazy'} decoding="async" style={`width:${size}px;height:${size}px;object-fit:cover;flex-shrink:0;border-radius:50%`} />
