---
import SiteLayout from '../layouts/SiteLayout.astro';
import { canonicalUrl } from '../lib/site';
import { loadHeroes, loadItemGroup, type SharedItem } from '../lib/catalog.mjs';
import Breadcrumbs from './Breadcrumbs.astro';
import CatalogItems from './CatalogItems.astro';
interface Props { item: SharedItem; }
const { item } = Astro.props;
const previewOnly = item.availableToApply === false;
const isOriginal = item.filter === 'original';
const family = await loadItemGroup(item.sourceId);
const source = family?.source;
const replacements = family?.replacements || [];
const link = canonicalUrl(item.path);
const store = 'https://play.google.com/store/apps/details?id=com.nutcx.tools';
const appLink = `intent://nutcx.github.io${item.path}#Intent;scheme=https;package=com.nutcx.tools;S.browser_fallback_url=${encodeURIComponent(store)};end`;
const hero = item.kind === 'skin' ? (await loadHeroes()).find(hero => hero.id === item.heroId) : undefined;
const context = hero ? `${hero.name} skin` : `${item.group || 'Preparation'} resource`;
const pageTitle = `${item.name} – ${context} preview`;
const pageDescription = `${item.name}: ${context.toLowerCase()} preview. ${item.description}. ${previewOnly ? 'Preview only; currently unavailable to apply.' : 'View the image, share this item, or open it in NutCracker.'}`;
const breadcrumbItems = [
  ...(item.kind === 'skin'
    ? [{name:'Heroes',path:'/heroes/'},{name:hero?.name || `Hero ${item.heroId}`,path:`/heroes/${item.heroId}/`}]
    : [{name:'Preparations',path:'/preparations/'}]),
  ...(!isOriginal && source ? [{name:source.name,path:source.path}] : []),
  {name:item.name,path:item.path},
];
const backPath = !isOriginal && source ? `${source.path}#replacements` : item.kind === 'skin' ? `/heroes/${item.heroId}/` : '/preparations/';
const backLabel = !isOriginal && source ? `Replacements for ${source.name}` : item.kind === 'skin' ? 'Back to hero skins' : 'Back to preparations';
---
<SiteLayout canonicalPath={item.path} title={pageTitle} description={pageDescription} socialImage={item.image || undefined}>
  <article class="item-preview">
    <a class="item-back" href={backPath}>← {backLabel}</a>
    <Breadcrumbs items={breadcrumbItems} />
    <div class="item-grid">
      <div class="item-art">
        {item.image ? <img src={item.image} alt={`${item.name} – ${context} preview`} width="960" height="720" fetchpriority="high" decoding="async" /> : <span>Preview image unavailable</span>}
      </div>
      <div class="item-copy">
        <p class="eyebrow">{context} preview</p>
        <h1>{item.name}</h1>
        <p>{item.description}</p>
        {!isOriginal && source && <p class="item-source">Replaces <a href={source.path}>{source.name}</a>. <a href={`${source.path}#replacements`}>View its replacement options →</a></p>}
        <dl class="item-facts"><div><dt>Catalog</dt><dd>{hero?.name || item.group || 'Preparations'}</dd></div><div><dt>Type</dt><dd>{item.filter}</dd></div>{item.kind === 'preparation' && <div><dt>Availability</dt><dd>{previewOnly ? 'Preview only' : 'Archive listed; check in app'}</dd></div>}</dl>
        {previewOnly && <p class="item-unavailable" role="status">{item.kind === 'skin'
          ? 'The original archive is unavailable. You can still browse its replacement options below.'
          : 'Preview only — this item is not available to apply in the app yet.'}</p>}
        <div class="item-actions">
          {isOriginal && replacements.length > 0 && <a class="button button--primary" href="#replacements">View {replacements.length} replacement{replacements.length === 1 ? '' : 's'}</a>}
          <a class:list={['button', isOriginal && replacements.length > 0 ? 'button--secondary' : 'button--primary']} href={appLink}>Open in NutCracker</a>
          <a class="button button--secondary" href={store} data-play-placement="item-preview">Get the Android app</a>
          <button class="button button--secondary" data-copy={link} data-copy-message="Item link copied">Copy link</button>
        </div>
        <p class="item-note">{previewOnly
          ? 'You can still open this preview in the Android app. If you just installed the app, return to this page and tap Open in NutCracker.'
          : 'Open this item in the Android app to see its available options. If you just installed the app, return to this page and tap Open in NutCracker.'}</p>
        <p class="item-help"><a href="/guides/shared-previews/">How to open and share previews</a> · <a href="/guides/troubleshooting/">Get help with an unavailable item</a></p>
      </div>
    </div>
    {isOriginal && <section class="item-replacements" id="replacements" aria-labelledby="replacements-heading">
      <h2 id="replacements-heading">Replacements for {item.name}</h2>
      {replacements.length > 0 ? <><p>These options are for {item.name}. Open a replacement to preview or share it.</p><CatalogItems items={replacements} preparation={item.kind === 'preparation'} headingLevel={3} /></>
        : <p>No replacements are currently listed for this original.</p>}
    </section>}
  </article>
</SiteLayout>
<style>
  .item-preview{max-width:1160px;margin:auto;padding:40px 24px 80px}.item-back{display:inline-block;margin-bottom:28px;color:var(--text-muted)}
  .item-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:48px;align-items:center}.item-art{border-radius:24px;overflow:hidden;background:#231c19;min-height:280px;display:grid;place-items:center}.item-art img{width:100%;height:auto;max-height:580px;object-fit:contain}.item-copy h1{font-size:clamp(2rem,5vw,3.8rem);line-height:1.08;overflow-wrap:anywhere;margin:12px 0 24px}.item-actions{display:flex;flex-wrap:wrap;gap:12px;margin:28px 0}.item-note{font-size:.9rem;line-height:1.7;opacity:.7}.item-copy>p{line-height:1.7}
  .item-unavailable{padding:12px 16px;border:1px solid var(--outline-soft);border-radius:12px;background:var(--surface-low);color:var(--text)}
  .item-facts{margin-top:20px;padding:16px;background:var(--surface-low);border-radius:12px}.item-facts>div{display:flex;flex-wrap:wrap;gap:8px 20px;padding:4px 0}.item-facts dt{min-width:90px;color:var(--text-muted)}.item-facts dd{text-transform:capitalize}.item-help{margin-top:20px;font-size:.9rem}.item-help a{color:var(--primary-bright);text-decoration:underline}
  @media(max-width:720px){.item-grid{grid-template-columns:1fr;gap:24px}.item-preview{padding-top:24px}.item-art{min-height:200px}.item-actions{flex-direction:column}}
  .item-replacements{margin-top:48px;padding-top:32px;border-top:1px solid var(--outline-soft);scroll-margin-top:100px}.item-replacements>h2{font-size:1.6rem;line-height:1.3;overflow-wrap:anywhere}.item-replacements>p{margin:12px 0 24px;color:var(--text-soft);line-height:1.7}.item-source a{color:var(--primary-bright);text-decoration:underline}
</style>
