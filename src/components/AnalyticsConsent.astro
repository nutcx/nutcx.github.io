---
interface Props { enabled?: boolean; }
const { enabled = true } = Astro.props;
---
<aside class="analytics-choice" data-analytics-panel data-analytics-enabled={String(enabled)} aria-label="Website analytics choices" hidden>
  <div><h2>Help improve NutCracker</h2><p>Allow Google Analytics to measure page visits and Google Play clicks? Optional analytics uses cookies. Your search text is not collected. <a href="/privacy/#website-analytics">Details</a></p><p data-analytics-status role="status" aria-live="polite"></p></div>
  <div class="analytics-actions"><button type="button" class="button button--secondary" data-analytics-decline>No thanks</button><button type="button" class="button button--primary" data-analytics-accept>Allow analytics</button><button type="button" class="analytics-close" data-analytics-close aria-label="Close analytics choices" hidden>Close</button></div>
</aside>
<script>import '../scripts/analytics';</script>
<style>
  .analytics-choice{position:fixed;z-index:80;bottom:16px;left:16px;right:16px;max-width:820px;margin:auto;padding:20px;border:1px solid var(--outline);border-radius:20px;background:var(--surface);box-shadow:var(--shadow);display:flex;gap:24px;align-items:center;max-height:80vh;overflow:auto}.analytics-choice[hidden]{display:none}.analytics-choice h2{font-size:1.1rem;line-height:1.4}.analytics-choice p{font-size:.85rem;line-height:1.6;color:var(--text-soft);margin-top:6px}.analytics-choice a{color:var(--primary-bright);text-decoration:underline}.analytics-actions{display:flex;flex-shrink:0;flex-direction:column;gap:8px}.analytics-actions .button{min-height:44px;padding:10px 16px;white-space:nowrap}.analytics-close{color:var(--text-soft);background:transparent;border:0;min-height:44px;text-decoration:underline}.analytics-close[hidden]{display:none}@media(max-width:560px){.analytics-choice{flex-direction:column;align-items:stretch;gap:12px;padding:16px;bottom:8px;left:8px;right:8px}.analytics-actions{flex-direction:row;flex-wrap:wrap}.analytics-actions .button{flex:1}}
</style>
