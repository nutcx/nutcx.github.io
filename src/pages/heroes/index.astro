---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadHeroes } from '../../lib/catalog.mjs';
import HeroPortrait from '../../components/HeroPortrait.astro';
import '../../styles/catalog.css';
const heroes = await loadHeroes();
---
<SiteLayout title="Hero Skin Catalog" description="Find a hero, compare original, official, custom and anime skin previews, and share a link or open your selection in NutCracker Tools." page="heroes">
  <div class="catalog-shell">
    <header class="catalog-heading"><p class="eyebrow">Content library</p><h1>Hero skin catalog.</h1><p>Browse {heroes.length} heroes with available skin previews. Choose a hero to compare the catalog's original, official, custom and anime options, then share a preview or open it in the Android app.</p><a href="/guides/shared-previews/">How to use and share previews →</a> · <a href="/preparations/">Browse preparations →</a></header>
    <section data-catalog>
      <div class="catalog-controls"><label>Search heroes<input type="search" placeholder="Hero name or ID…" data-catalog-search /></label></div>
      <p class="catalog-count" role="status" aria-live="polite" data-catalog-count>{heroes.length} heroes</p>
      <div class="hero-grid">
        {heroes.map(hero => <a class="hero-card" href={`/heroes/${hero.id}/`} data-catalog-card data-search={`${hero.name} ${hero.id}`}>
          {hero.image ? <HeroPortrait src={hero.image} size={72} /> : <span class="hero-placeholder">{hero.name[0]}</span>}
          <div><h2>{hero.name}</h2><p>{hero.items.length} skin options</p><small>Hero #{hero.id}</small></div><span aria-hidden="true">↗</span>
        </a>)}
      </div>
      <div class="catalog-empty" data-catalog-empty hidden><h2>No heroes found</h2><p>Try another name or hero ID.</p><button class="button button--secondary" data-catalog-reset>Clear search</button></div>
    </section>
  </div>
</SiteLayout>
<script>import '../../scripts/catalog';</script>
