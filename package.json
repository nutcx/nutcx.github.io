{
  "name": "nutcracker-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "validate": "node scripts/validate-site.mjs",
    "test:content-delivery": "node scripts/test-public-content-manifest.mjs",
    "test:client-version": "node --test scripts/test-client-version.mjs",
    "test:discord": "node --test scripts/test-discord-content-diff.mjs scripts/test-discord-comparison-image.mjs scripts/test-discord-image-fetch.mjs scripts/test-discord-content-notifier.mjs",
    "test:featured": "node scripts/test-featured-selection.mjs && node scripts/test-featured-pages.mjs",
    "test": "pnpm build && pnpm validate && node scripts/test-item-links.mjs && node scripts/test-retirements.mjs && node scripts/test-analytics.mjs && node scripts/test-search-readiness.mjs && node scripts/test-catalog-browsing.mjs && pnpm test:featured && pnpm test:content-delivery && pnpm test:client-version && pnpm test:discord"
  },
  "dependencies": {
    "astro": "7.2.10",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
